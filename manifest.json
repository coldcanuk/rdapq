{
  "name": "rdap-q",
  "version": "1.4.0",
  "protocol_name": "RDAP-Q Agent Engineering Protocol",
  "entrypoint": "rdap-q-skill/SKILL.md",
  "invocation": "/rdapq",
  "home_env": "RDAPQ_HOME",
  "home_defaults": {
    "windows": "%USERPROFILE%\\.rdapq",
    "unix": "${HOME}/.rdapq"
  },
  "repository_state": ".rdapq/state",
  "always_load": [
    "rdap-q-skill/SKILL.md"
  ],
  "phase_load": {
    "BOOTSTRAP": [
      "rdap-q-skill/playbooks/00-bootstrap.md"
    ],
    "DISCOVERY": [
      "rdap-q-skill/playbooks/01-discovery.md"
    ],
    "PLAN": [
      "rdap-q-skill/playbooks/02-planning.md"
    ],
    "ARCHITECTURE": [
      "rdap-q-skill/playbooks/03-architecture.md"
    ],
    "IMPLEMENT": [
      "rdap-q-skill/playbooks/04-implementation.md"
    ],
    "VERIFY": [
      "rdap-q-skill/playbooks/05-verification.md"
    ],
    "AUDIT": [
      "rdap-q-skill/playbooks/06-final-audit.md",
      "rdap-q-skill/playbooks/07-git-worktree.md"
    ]
  },
  "event_load": {
    "controller_ambiguity": [
      "rdap-q-skill/core/controller.md"
    ],
    "tool_mapping": [
      "rdap-q-skill/core/capabilities.md"
    ],
    "memory_read_write_invalidate": [
      "rdap-q-skill/core/memory.md"
    ],
    "gate_evaluation": [
      "rdap-q-skill/core/gates.md"
    ],
    "score_calculation": [
      "rdap-q-skill/core/scoring.md"
    ],
    "milestone_quality_decision": [
      "rdap-q-skill/core/scoring.md",
      "rdap-q-skill/core/gates.md",
      "rdap-q-skill/core/exit-logic.md"
    ],
    "terminal_decision": [
      "rdap-q-skill/core/scoring.md",
      "rdap-q-skill/core/gates.md",
      "rdap-q-skill/core/exit-logic.md"
    ],
    "git_mutation": [
      "rdap-q-skill/playbooks/07-git-worktree.md"
    ]
  },
  "commands": {
    "/rdapq": "Start or continue RDAP-Q execution on the supplied task.",
    "/rdapq status": "Show phase, depth, oracle Q, gates, blockers, and round.",
    "/rdapq score": "Show oracle Q. Write the 8-dimension card only for this command, as a model label.",
    "/rdapq depth": "Set depth to lean, standard, or full. The user switch wins over the effort fallback.",
    "/rdapq audit": "Run the adversarial final-audit procedure.",
    "/rdapq resume": "Reload persistent memory/state, inspect drift, and resume safely.",
    "/rdapq memory": "Show relevant RDAP-Q memory and its validity status.",
    "/rdapq research": "Enter discovery. Implies standard or full for this task.",
    "/rdapq explain": "Explain the current depth, phase, or exit."
  },
  "terminal_states": [
    "COMPLETE",
    "BLOCKED",
    "STALLED",
    "CONSTRAINT_LIMITED",
    "FAILED_VERIFICATION",
    "UNCLEAR_TASK",
    "MISSING_TEST"
  ]
}
